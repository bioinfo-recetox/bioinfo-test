@article{Pacinkova2023a,
  author    = {Pačinková, Anna and Popovici, Vlad},
  title     = {IntOMICS: A Bayesian Framework for Reconstructing Regulatory Networks Using Multi-Omics Data},
  journal   = {Journal of Computational Biology},
  volume    = {30},
  number    = {5},
  pages     = {569--574},
  year      = {2023},
  doi       = {10.1089/cmb.2022.0149},
  url       = {https://doi.org/10.1089/cmb.2022.0149},
  note      = {PMID: 36961919},
  abstract  = {Integration of multi-omics data can provide a more complex view of the biological system consisting of different interconnected molecular components. We present a new comprehensive R/Bioconductor package, IntOMICS, which implements a Bayesian framework for multi-omics data integration using a Markov Chain Monte Carlo sampling scheme, complementing missing biological prior knowledge with an empirical estimate from the available experimental data. IntOMICS has the potential to be a powerful resource for exploratory systems biology.},
  keywords  = {multiomics, methods, gacr},
}

@article{aust2024amb,
  author    = {Aust, A. C. and Vidova, V. and Coufalikova, K. and Smetanova, S. and Kozeluhova, K. and Micenkova, L. and Videnska, P. and Smatana, S. and Budinská, Eva and Borek, I. and Janku, P. and Klanova, J. and Spacil, Z. and Thon, V.},
  title     = {Fecal tryptophan metabolite profiling in newborns in relation to microbiota and antibiotic treatment},
  journal   = {Applied Microbiology and Biotechnology},
  volume    = {108},
  number    = {1},
  pages     = {504},
  year      = {2024},
  doi       = {10.1007/s00253-024-13339-4},
  url       = {https://doi.org/10.1007/s00253-024-13339-4},
  abstract  = {In the first days of life, newborns' intestinal microbiota develops alongside the intestinal gut barrier and immunity. Antibiotic (ATB) treatment of mothers before or during delivery affects the microbial and tryptophan metabolite composition of stool of caesarean- and vaginal-delivered newborns. From 134 samples from the CELSPAC: TNG cohort, 16S rRNA sequencing and tryptophan metabolite quantification (UHPLC-MS/MS) were performed. Microbial diversity and tryptophan metabolite concentrations were significantly higher in stool than in meconium; the positive effect of vaginal delivery on newborn microbiome development is degraded when the mother is treated with ATB before or during delivery.},
}
% No legacy tags/categories were set for the entry above — left uncategorized.

@article{micenkova2024benefmicrobes,
  author    = {Micenková, L. and Brodiková, K. and Smetanová, S. and Bosák, J. and Šmajs, D. and Andrla, P. and Budinská, Eva},
  title     = {High colonisation by probiotic Escherichia coli A0 34/86 strain is associated with a less diverse microbiome related to children's age},
  journal   = {Beneficial Microbes},
  volume    = {15},
  number    = {1},
  pages     = {5--17},
  year      = {2024},
  doi       = {10.1163/18762891-20220049},
  url       = {https://doi.org/10.1163/18762891-20220049},
  abstract  = {Probiotic supplementation in childhood represents an opportunity to beneficially manipulate the intestinal microbiome. We report the association between gut microbiome composition and colonisation capacity of the probiotic strain Escherichia coli A0 34/86 in three healthy children at different development stages, using 16S rRNA gene sequencing and colony PCR. In all children, genetic determinants typical for the probiotic strain were detected immediately after administration; infants and toddlers with lower bacterial diversity were more successfully colonised, suggesting CNB probiotics may be most effective in very early childhood.},
}
% No legacy tags/categories were set for the entry above — left uncategorized.

@article{klvanova2024fcim,
  author    = {Klvanova, E. and Videnska, P. and Barton, V. and Bohm, J. and Splichalova, P. and Koksova, V. and Urik, M. and Lanickova, B. and Prokes, R. and Budinská, Eva and Klanova, J. and Borilova Linhartova, P.},
  title     = {Resistome in the indoor dust samples from workplaces and households: a pilot study},
  journal   = {Frontiers in Cellular and Infection Microbiology},
  volume    = {14},
  pages     = {1484100},
  year      = {2024},
  doi       = {10.3389/fcimb.2024.1484100},
  url       = {https://doi.org/10.3389/fcimb.2024.1484100},
  abstract  = {Antibiotic resistance genes (ARGs) in the dust resistome of workplaces and households have gone relatively unexplored. This pilot study analyzed resistome in indoor dust from a pediatric hospital, a maternity hospital, a research center and households, comparing HT-qPCR and whole metagenome shotgun sequencing (WMGS). 143 ARGs were detected by HT-qPCR (MLSB phenotype genes most abundant) versus 36 by WMGS, with higher relative ARG quantity in workplace dust than households, highest at the pediatric hospital.},
}
% No legacy tags/categories were set for the entry above — left uncategorized.

@article{10.3389/fonc.2024.1367231,
  author    = {Budinská, Eva and Čarnogurská, Martina and Ivković, Tina Catela and Macháčková, Táňa and Boudná, Marie and Pifková, Lucie and Slabý, Ondřej and Bencsiková, Beatrix and Popovici, Vlad},
  title     = {An invasion front gene expression signature for higher-risk patient selection in stage IIA MSS colon cancer},
  journal   = {Frontiers in Oncology},
  volume    = {14},
  year      = {2024},
  issn      = {2234-943X},
  doi       = {10.3389/fonc.2024.1367231},
  url       = {https://www.frontiersin.org/journals/oncology/articles/10.3389/fonc.2024.1367231},
  abstract  = {Stage II colon cancer (CC) encompasses a heterogeneous group of patients with diverse survival experiences. We hypothesized that, aside from bulk tumor features, focusing on the invasion front may provide additional clues for stratification. A retrospective matched case-control collection of 39 stage IIA microsatellite-stable (MSS) untreated CCs was analyzed; the best performing signature was based on invasion front profiles (AUC = 0.931), containing genes associated with KRAS pathway activation, apical junction complex, and heme metabolism. Combination with the bulk tumor classifier further improved prediction accuracy.},
  keywords  = {crc, biomarkers, azv},
}

@article{pivrncova2024scirep,
  author    = {Pivrncova, Eliska and Buresova, Lucie and Kotaskova, Iva and Videnska, Petra and Andryskova, Lenka and Piler, Pavel and Janku, Petr and Borek, Ivo and Bohm, Jan and Lanickova, Barbara and Klanova, Jana and Budinská, Eva and Borilova Linhartova, Petra},
  title     = {Impact of intrapartum antibiotic prophylaxis on the oral and fecal bacteriomes of children in the first week of life},
  journal   = {Scientific Reports},
  volume    = {14},
  pages     = {18163},
  year      = {2024},
  doi       = {10.1038/s41598-024-68953-z},
  url       = {https://www.nature.com/articles/s41598-024-68953-z},
  note      = {The DOI in the source front matter (10.1186/s12866-023-02951-5) was actually the DOI of a different paper (see konecna2023bmcmicrobiology above) — a copy-paste error in the legacy site. The DOI above was instead derived from this article's Nature URL slug (Scientific Reports DOIs are always 10.1038/ + the URL slug); please double check it.},
  abstract  = {Intrapartum antibiotic prophylaxis (IAP) is commonly used during C-section delivery and before vaginal delivery in Group B Streptococcus-positive women. In 33 mother-neonate pairs exposed to antibiotics and 33 unexposed controls, differences in alpha diversity and bacterial composition between groups were detected only in neonatal oral samples collected within 48h of birth; IAP was associated with decreased alpha diversity and altered genus abundances in transitional stool samples, suggesting IAP may significantly influence early neonatal oral and gut microbiome development.},
  keywords  = {microbiome},
}

@article{camandona2025bmkres,
  author    = {Camandona, Alessandro and Gagliardi, Amedeo and Licheri, Nicola and Tarallo, Sonia and Francescato, Giulia and Budinská, Eva and Čarnogurská, Martina and Zwinsová, Barbora and Martinoglio, Barbara and Franchitti, Lorenzo and Gallo, Gaetano and Cutrupi, Santina and De Bortoli, Michele and Pardini, Barbara and Naccarati, Alessio and Ferrero, Giulio},
  title     = {Multiple regulatory events contribute to a widespread circular RNA downregulation in precancer and early stage of colorectal cancer development},
  journal   = {Biomarker Research},
  volume    = {13},
  number    = {1},
  pages     = {30},
  year      = {2025},
  doi       = {10.1186/s40364-025-00744-8},
  url       = {https://doi.org/10.1186/s40364-025-00744-8},
  abstract  = {Background: circular RNAs (circRNAs) are covalently closed transcripts whose dysregulation is reported in CRC, but little is known about early carcinogenesis. Methods: integrative analysis of circRNA profiles in RNA-Seq data of 96 colorectal cancers, 27 adenomas and matched adjacent mucosa. Results: 34 circRNAs were significantly dysregulated (almost exclusively downregulated), associated with decreased expression of host genes and RNA-binding proteins involved in circRNA biogenesis. Conclusions: multiple altered regulatory mechanisms may contribute to reduced circRNA levels characterizing early colorectal carcinogenesis.},
}
