@article{piccinno2025natmed2,
  author    = {Piccinno, Gianmarco and Thompson, K. N. and Manghi, P. and Ghazi, A. R. and Thomas, A. M. and Blanco-Míguez, A. and Asnicar, F. and Mladenovic, K. and Pinto, F. and Armanini, F. and Punčochář, M. and Piperni, E. and Heidrich, V. and Fackelmann, G. and Ferrero, Giulio and Tarallo, Sonia and Nguyen, L. H. and Yan, Y. and Keles, N. A. and Tuna, B. G. and Vymetalkova, Veronika and Trompetto, Mario and Liska, Vaclav and Hucl, Tomas and Vodicka, Pavel and Bencsiková, Beatrix and Čarnogurská, Martina and Popovici, Vlad and Marmorino, F. and Cremolini, Chiara and Pardini, Barbara and Cordero, Francesca and Song, M. and Chan, A. T. and Derosa, Lisa and Zitvogel, Laurence and Huttenhower, C. and Naccarati, Alessio and Budinská, Eva and Segata, Nicola},
  title     = {Pooled analysis of 3,741 stool metagenomes from 18 cohorts for cross-stage and strain-level reproducible microbial biomarkers of colorectal cancer},
  journal   = {Nature Medicine},
  volume    = {31},
  number    = {7},
  pages     = {2416--2429},
  year      = {2025},
  doi       = {10.1038/s41591-025-03693-9},
  url       = {https://doi.org/10.1038/s41591-025-03693-9},
  abstract  = {Associations between the gut microbiome and colorectal cancer (CRC) have been uncovered, but larger and more diverse studies are needed. This study expanded 12 metagenomic datasets (n=2,116) with 6 new cohorts (n=1,625), improving CRC prediction accuracy from gut metagenomics alone (average AUC=0.85) and identifying 19 newly profiled species. Strain-specific CRC signatures were identified in Ruminococcus bicirculans and Faecalibacterium prausnitzii, confirming the microbiome as a clinical target for CRC screening and a biomarker for CRC progression.},
}
