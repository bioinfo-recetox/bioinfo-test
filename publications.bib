@article{carnogurska2025cancmed,
  author    = {Čarnogurská, Martina and Vasylieva, Valeriia Serhiivna and Macháčková, Táňa and Boudná, Marie and Pifková, Lucie and Orlíčková, Jana and Ivkovic, Tina Catela and Slabý, Ondřej and Bencsiková, Beatrix and Popovici, Vlad and Budinská, Eva},
  title     = {Search for Mutations Connected With Non-Response to Anti-EGFR Therapy in mCRC in the Morphologically Defined Regions of Primary Tumours},
  journal   = {Cancer Medicine},
  volume    = {14},
  number    = {9},
  pages     = {e70910},
  year      = {2025},
  doi       = {10.1002/cam4.70910},
  url       = {https://doi.org/10.1002/cam4.70910},
  abstract  = {Background: tumour morphological heterogeneity may influence mutational profiles relevant to anti-EGFR therapy response. Methods: genetic mutations were investigated in 142 samples from 39 KRAS wild-type metastatic colorectal cancer patients, across whole-tumour sections and six morphology-defined regions by deep NGS. Results: mutations linked to anti-EGFR response (KRAS, BRAF, NRAS, PTEN, PI3KCA) were found uniquely in non-responders, with substantial variability across morphological sub-regions; sub-region profiles provided more detail than whole-tumour profiling. Conclusion: comprehensive analysis considering morphological heterogeneity is crucial for personalised CRC treatment strategies.},
  keywords  = {multiomics, morphotypes, azv},
}

@article{dragomir2025jpcr,
  author    = {Dragomir, Mihnea-Paul and Popovici, Vlad and Schallenberg, S. and Čarnogurská, Martina and Horst, D. and Nenutil, Rudolf and Bosman, Fred and Budinská, Eva},
  title     = {A quantitative tumor-wide analysis of morphological heterogeneity of colorectal adenocarcinoma},
  journal   = {The Journal of Pathology: Clinical Research},
  volume    = {11},
  number    = {4},
  pages     = {e70034},
  year      = {2025},
  doi       = {10.1002/2056-4538.70034},
  url       = {https://doi.org/10.1002/2056-4538.70034},
  abstract  = {The intertumoral and intratumoral morphologic heterogeneity of colorectal adenocarcinoma (CRC) is poorly understood. Three pathologists evaluated dominant, secondary and tertiary morphology on a pilot set of 22 CRCs; an AI-based image analysis tool was then trained and applied to 161 stage I-IV primary CRCs (644 H&E sections). Most tumors had two or three dominant morphotypes; complex tubular was most common, desmoplastic was associated with worse outcomes, and papillary with better outcomes. Morphological shifts accompany tumor progression, and proportions of morphologies, not heterogeneity per se, are associated with clinical outcomes.},
  keywords  = {morphotypes, gacr},
}

@article{zitvogel2025natmed1,
  author    = {Zitvogel, Laurence and Derosa, Lisa and Routy, Bertrand and Loibl, Sibylle and Heinzerling, Lucie and de Vries, I. Jolanda M. and Engstrand, Lars and Segata, Nicola and Kroemer, Guido and Alves Costa Silva, Carolina and Barbieri, Daniela and Boleij, Annemarie and Bol, Kalijn and Brusselaers, Nele and Budinská, Eva and Caldas, Carlos and Cordero, Francesca and Cremolini, Chiara and Daillere, Romain and Denkert, Carsten and Durand, Sylvere and Ehrlich, Stanislav and Eisinger, François and Elkrief, Arielle and Fall, Katja and Felder, Baerbel and Ferrere, Gladys and Fidelle, Marine and Gaborit, Jérôme and Gariboldi, Manuela and Guindo, Cheick Oumar and Iebba, Valerio and Lehtio, Janne and Martineau, Magalie and Messaoudene, Meriem and Monville, Florence and Naccarati, Alessio and Pardini, Barbara and Pinto, Federica and Piccinno, Gianmarco and Pizzato, Eugénie and Popovici, Vlad and Rachid, Maan Haj and Tarallo, Sonia and Schuler-Thurner, Beatrice and Schuler, Gerold and Szallasi, Zoltan and Sow, Cissé and Trinchieri, Giorgio and Trochon, Jean-Jacques and Zeller, Georg},
  title     = {Impact of the ONCOBIOME network in cancer microbiome research},
  journal   = {Nature Medicine},
  volume    = {31},
  number    = {4},
  pages     = {1085--1098},
  year      = {2025},
  doi       = {10.1038/s41591-025-03608-8},
  url       = {https://doi.org/10.1038/s41591-025-03608-8},
  abstract  = {The EU-sponsored ONCOBIOME network spurred an international effort to identify and validate gut microbiota-related biomarkers in oncology, generating a unique and publicly available microbiome resource. ONCOBIOME explored the effects of the microbiota on gut permeability and metabolism as well as antimicrobial and antitumor immune responses, developing diagnostic methods based on oncomicrobiome signatures for diagnosis, prognosis and treatment response. This review discusses key advances of the network and progress toward translating them into oncology clinical practice.},
}
