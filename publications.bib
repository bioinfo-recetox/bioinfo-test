@article{bartos2025oto,
  author    = {Bartos, M. and Urik, M. and Buresova, L. and Holochova, P. and Budinská, Eva and Borilova Linhartova, P.},
  title     = {Bacteriome of the Middle Ear in Children and Young Adults With Cholesteatoma and Retraction Pocket: A Pilot Study},
  journal   = {OTO Open},
  volume    = {9},
  number    = {1},
  pages     = {e70051},
  year      = {2025},
  doi       = {10.1002/oto2.70051},
  url       = {https://doi.org/10.1002/oto2.70051},
  abstract  = {Objective: chronic otitis media (COM) is a common middle ear disease in children and young adults; this pilot study compared middle ear bacteriomes in serious forms of COM (cholesteatoma, retraction pocket) with healthy controls. Methods: middle ears were swabbed during surgery on 23 cholesteatoma, 26 retraction pocket, and 15 cochlear-implant control patients, with 16S rDNA sequencing. Results: bacterial diversity was generally low, dominated by 1-2 bacteria; positivity for one or more genera was higher in cholesteatoma/retraction pocket (38.8%) than controls (6.7%). Conclusion: findings support that retraction pocket could be a pre-cholesteatoma stage.},
}
