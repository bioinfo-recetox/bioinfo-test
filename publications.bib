@article{budinska_molecular_2023,
  author    = {Budinská, Eva and Hrivňáková, Martina and Ivkovic, Tina Catela and Madrzyk, Marie and Nenutil, Rudolf and Bencsiková, Beatrix and Al Tukmachi, Dagmar and Ručková, Michaela and Zdražilová Dubská, Lenka and Slabý, Ondřej and Feit, Josef and Dragomir, Mihnea-Paul and Borilova Linhartova, Petra and Tejpar, Sabine and Popovici, Vlad},
  title     = {Molecular portraits of colorectal cancer morphological regions},
  journal   = {eLife},
  volume    = {12},
  pages     = {RP86655},
  year      = {2023},
  month     = nov,
  editor    = {Yang, Yongliang and Liu, Caigang},
  issn      = {2050-084X},
  doi       = {10.7554/eLife.86655},
  url       = {https://doi.org/10.7554/eLife.86655},
  note      = {Publisher: eLife Sciences Publications, Ltd},
  abstract  = {Heterogeneity of colorectal carcinoma (CRC) represents a major hurdle towards personalized medicine. We investigated intra-tumor heterogeneity by morphology-guided transcriptomics of six morphological patterns (morphotypes): complex tubular, desmoplastic, mucinous, papillary, serrated, and solid/trabecular. Whole-transcriptome profiling of 202 tumor regions from 111 stage II-IV CRCs identified morphotype-specific gene expression profiles, with proportion of cell types and epithelial differentiation as main drivers of the observed disparities. Most gene expression-based classifiers exhibited important morphotype-dependent variability, with regional predictions often contradicting whole-tumor classification. Morphotype-based tumor sampling allows detection of molecular features otherwise distilled in whole tumor profile, while maintaining histopathology context for interpretation.},
  keywords  = {multiomics, morphotypes, gacr},
}

@article{pardini2023gastroenterology,
  author    = {Pardini, Barbara and Ferrero, Giulio and Tarallo, Sonia and Gallo, Gaetano and Francavilla, Antonio and Licheri, Nicola and Trompetto, Mario and Clerico, Giuseppe and Senore, Carlo and Peyre, Sergio and Vymetalkova, Veronika and Vodickova, Ludmila and Liska, Vaclav and Vycital, Ondrej and Levy, Miroslav and Macinga, Peter and Hucl, Tomas and Budinská, Eva and Vodicka, Pavel and Cordero, Francesca and Naccarati, Alessio},
  title     = {A Fecal MicroRNA Signature by Small RNA Sequencing Accurately Distinguishes Colorectal Cancers: Results From a Multicenter Study},
  journal   = {Gastroenterology},
  volume    = {165},
  number    = {3},
  pages     = {582--599.e8},
  year      = {2023},
  doi       = {10.1053/j.gastro.2023.05.037},
  url       = {https://doi.org/10.1053/j.gastro.2023.05.037},
  abstract  = {Background & Aims: fecal tests currently used for colorectal cancer (CRC) screening show limited accuracy in detecting early tumors or precancerous lesions; we evaluated stool microRNA (miRNA) profiles as biomarkers for noninvasive CRC diagnosis. Methods: 1273 small RNA sequencing experiments were performed across multiple biospecimens and cohorts. Results: a 5-miRNA signature distinguished CRC patients from controls (AUC 0.86, validated at AUC 0.96) and also classified low-/high-stage tumors and advanced adenomas. Conclusions: this comprehensive fecal miRNome analysis identified a signature accurately discriminating cancer, aimed at improving noninvasive diagnosis and screening strategies.},
}
