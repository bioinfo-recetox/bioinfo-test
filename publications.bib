@article{prochazkova2022frontnutr,
  author    = {Prochazkova, Magdalena and Budinska, Eva and Kuzma, Marek and Pelantova, Helena and Hradecky, Jaromir and Heczkova, Marie and Daskova, Nikola and Bratova, Miriam and Modos, Istvan and Videnska, Petra and Splichalova, Petra and Sowah, Solomon A. and Kralova, Maria and Henikova, Marina and Selinger, Eliska and Klima, Krystof and Chalupsky, Karel and Sedlacek, Radislav and Landberg, Rikard and Kühn, Tilman and Gojda, Jan and Cahova, Monika},
  title     = {Vegan Diet Is Associated With Favorable Effects on the Metabolic Performance of Intestinal Microbiota: A Cross-Sectional Multi-Omics Study},
  journal   = {Frontiers in Nutrition},
  volume    = {8},
  year      = {2022},
  issn      = {2296-861X},
  doi       = {10.3389/fnut.2021.783302},
  url       = {https://www.frontiersin.org/journals/nutrition/articles/10.3389/fnut.2021.783302},
  abstract  = {Background and Aim: plant-based diets are associated with potential health benefits, but the contribution of gut microbiota remains to be clarified. Methods: this cross-sectional study involved lean, healthy vegans (n=62) and omnivore (n=33) subjects, using an integrated multi-omics approach (16S rRNA sequencing, metabolomics profiling). Results: the vegans had more favorable glucose and lipid homeostasis profiles; only 14.8% of detected bacterial genera differed in fecal microbiome, but significant differences in vegan and omnivore metabolomes were observed. Conclusion: while only small differences in gut microbiota were found between groups, their metabolic activity differed substantially.},
  keywords  = {microbiome},
}

@article{konecna2023bmcmicrobiology,
  author    = {Konečná, Eva and Videnska, Petra and Buresova, Lucie and Urik, Milan and Smetanova, Sona and Smatana, Stanislav and Prokes, Roma and Lanickova, Barbara and Budinská, Eva and Klanova, Jana and Borilova Linhartova, Petra},
  title     = {Enrichment of human nasopharyngeal bacteriome with bacteria from dust after short-term exposure to indoor environment: a pilot study},
  journal   = {BMC Microbiology},
  volume    = {23},
  pages     = {202},
  year      = {2023},
  doi       = {10.1186/s12866-023-02951-5},
  url       = {https://doi.org/10.1186/s12866-023-02951-5},
  abstract  = {Background: indoor dust particles are an everyday source of human exposure to microorganisms; we aimed to characterize changes in human nasopharyngeal bacteriome after short-term exposure to indoor (workplace) environments. Methods: nasopharyngeal swabs were taken from 22 participants before and after 8h at the workplace, alongside indoor dust samples from households and workplaces, analysed by 16S rRNA sequencing. Results: Staphylococcus and Corynebacterium were the most abundant genera; after 8h of workplace exposure, enrichment of the nasopharynx with new bacterial genera present in indoor dust was observed in 76% of participants. Conclusions: short-term exposure to the indoor environment can enrich the nasopharynx with bacterial DNA from indoor dust, varying by workplace environment.},
  keywords  = {microbiome},
}

